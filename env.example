# ═══════════════════════════════════════════════════════
# 🏓 Ping — Frontend Environment Variables
# ═══════════════════════════════════════════════════════
#
# Copy this file to .env and update the values as needed:
#   cp .env.example .env
#
# Vite exposes variables prefixed with VITE_ to the client.
# Do NOT put secrets here — everything is visible in the browser bundle.
#

# ─── API Base URL ─────────────────────────────────────
# The backend server URL (no trailing slash)
VITE_API_URL=http://localhost:3002
